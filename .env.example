# ============================================
# TaskPoints Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env with real credentials.
# ============================================

# Supabase backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# TaskPoints frontend runtime (Vercel)
TASKPOINTS_SUPABASE_URL=
TASKPOINTS_SUPABASE_ANON_KEY=
TASKPOINTS_STORAGE_BACKEND=supabase
TASKPOINTS_SUPABASE_SCHEMA=public
TASKPOINTS_ENABLE_TASK_TIMER=false

# Optional Vercel token for CLI automation
VERCEL_TOKEN=
